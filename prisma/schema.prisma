
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserStatus {
  ACTIVE
  DEACTIVATED

  @@map("user_status")
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER

  @@map("group_role")
}

enum VerificationPurpose {
  EMAIL
  EMAIL_CHANGE
  PASSWORD_RESET

  @@map("verification_purpose")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @db.VarChar(255)
  username     String?    @unique @db.VarChar(30)
  displayName  String     @map("display_name") @db.VarChar(100)
 passwordHash String @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  pendingEmail  String? @map("pending_email") @db.VarChar(255)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships  GroupMembership[]
  sessions     Session[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  userAgent        String? @map("user_agent") @db.VarChar(500)
  ipAddress        String? @map("ip_address") @db.VarChar(64)
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  tokenHash  String @unique @map("token_hash") @db.VarChar(128)
  purpose    VerificationPurpose
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model Group {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  currency String @db.Char(3) 
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  memberships GroupMembership[]

  @@map("groups")
}

model GroupMembership {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  groupId   String     @map("group_id") @db.Uuid
  role      GroupRole  @default(MEMBER)

  joinedAt  DateTime   @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime?  @map("left_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([id, groupId])
  @@index([groupId])
  @@index([userId])
  @@map("group_memberships")
}
