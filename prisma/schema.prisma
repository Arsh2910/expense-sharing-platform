generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DEACTIVATED

  @@map("user_status")
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER

  @@map("group_role")
}

enum VerificationPurpose {
  EMAIL
  EMAIL_CHANGE
  PASSWORD_RESET

  @@map("verification_purpose")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE

  @@map("split_type")
}

enum IdempotencyStatus {
  PENDING
  COMPLETED

  @@map("idempotency_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD

  @@map("email_outbox_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @db.VarChar(255)
  username        String?    @unique @db.VarChar(30)
  displayName     String     @map("display_name") @db.VarChar(100)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  pendingEmail    String?    @map("pending_email") @db.VarChar(255)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships             GroupMembership[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  createdExpenses         Expense[]           @relation("ExpenseCreatedBy")
  deletedExpenses         Expense[]           @relation("ExpenseDeletedBy")
  expensePayerAllocations ExpensePayer[]
  expenseSplitAllocations ExpenseSplit[]
  expenseRevisions        ExpenseRevision[]   @relation("ExpenseRevisionCreatedBy")
  groupBalances           GroupBalance[]
  settlementsSent         Settlement[]        @relation("SettlementFromUser")
  settlementsReceived     Settlement[]        @relation("SettlementToUser")
  settlementsCreated      Settlement[]        @relation("SettlementCreatedBy")
  idempotencyKeys         IdempotencyKey[]
  notifications           Notification[]
  sentInvitations         GroupInvitation[] @relation("InvitationInvitedBy")
  receivedInvitations     GroupInvitation[] @relation("InvitationInvitedUser")

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  tokenHash  String              @unique @map("token_hash") @db.VarChar(128)
  purpose    VerificationPurpose
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model Group {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  currency   String    @db.Char(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  memberships   GroupMembership[]
  expenses      Expense[]
  groupBalances GroupBalance[]
  settlements   Settlement[]
  invitations   GroupInvitation[]
  auditEvents   AuditEvent[]

  @@map("groups")
}

model GroupMembership {
  id      String    @id @default(uuid()) @db.Uuid
  userId  String    @map("user_id") @db.Uuid
  groupId String    @map("group_id") @db.Uuid
  role    GroupRole @default(MEMBER)

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([id, groupId])
  @@index([groupId])
  @@index([userId])
  @@map("group_memberships")
}

model Expense {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  description String    @db.Text
  category    String?   @db.VarChar(50)
  amount      BigInt    @db.BigInt
  splitType   SplitType @map("split_type")
  expenseDate DateTime  @map("expense_date") @db.Date
  createdById String    @map("created_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById String?   @map("deleted_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  group     Group             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy User              @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy User?             @relation("ExpenseDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  payers    ExpensePayer[]
  splits    ExpenseSplit[]
  revisions ExpenseRevision[]

  @@index([groupId, expenseDate(sort: Desc), id], map: "expenses_group_date_idx")
  @@index([createdById])
  @@map("expenses")
}

model ExpensePayer {
  expenseId String @map("expense_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  amount    BigInt @db.BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([expenseId, userId])
  @@index([userId, expenseId])
  @@map("expense_payers")
}

model ExpenseSplit {
  expenseId    String  @map("expense_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  amount       BigInt  @db.BigInt
  percentUnits BigInt? @map("percent_units") @db.BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([expenseId, userId])
  @@index([userId, expenseId])
  @@map("expense_splits")
}

model ExpenseRevision {
  id          String   @id @default(uuid()) @db.Uuid
  expenseId   String   @map("expense_id") @db.Uuid
  revision    Int
  snapshot    Json     @db.JsonB
  changes     Json?    @db.JsonB
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdBy User    @relation("ExpenseRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  notifications Notification[]

  @@unique([expenseId, revision])
  @@index([createdById])
  @@map("expense_revisions")
}

model GroupBalance {
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    BigInt   @default(0) @db.BigInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_balances")
}

model Settlement {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  fromUserId  String   @map("from_user_id") @db.Uuid
  toUserId    String   @map("to_user_id") @db.Uuid
  amount      BigInt   @db.BigInt
  settledOn   DateTime @map("settled_on") @db.Date
  note        String?  @db.VarChar(500)
  reversesId  String?  @unique @map("reverses_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group      Group       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  fromUser   User        @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser     User        @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy  User        @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reverses   Settlement? @relation("SettlementReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy Settlement? @relation("SettlementReversal")
  notifications Notification[]

  @@index([groupId, fromUserId])
  @@index([groupId, toUserId])
  @@index([createdById])
  @@map("settlements")
}

model IdempotencyKey {
  userId      String            @map("user_id") @db.Uuid
  scope       String            @db.VarChar(100)
  key         String            @db.VarChar(255)
  requestHash String            @map("request_hash") @db.VarChar(128)
  resourceId  String?           @map("resource_id") @db.Uuid
  status      IdempotencyStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model GroupInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  groupId       String           @map("group_id") @db.Uuid
  invitedUserId String?          @map("invited_user_id") @db.Uuid
  invitedEmail  String?          @map("invited_email") @db.VarChar(255)
  tokenHash     String?          @unique @map("token_hash") @db.VarChar(128)
  invitedById   String           @map("invited_by") @db.Uuid
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt    DateTime?        @map("accepted_at") @db.Timestamptz(6)
  declinedAt    DateTime?        @map("declined_at") @db.Timestamptz(6)
  revokedAt     DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUser User? @relation("InvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  notification Notification?

  @@index([groupId, status])
  @@index([invitedUserId, status])
  @@index([invitedEmail, status])
  @@map("group_invitations")
}

model EmailOutbox {
  id          String           @id @default(uuid()) @db.Uuid
  type        String           @db.VarChar(50)
  recipient   String           @db.VarChar(255)
  payload     Json             @db.JsonB
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int              @default(0)
  availableAt DateTime         @default(now()) @map("available_at") @db.Timestamptz(6)
  sentAt      DateTime?        @map("sent_at") @db.Timestamptz(6)
  lastError   String?          @map("last_error") @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("email_outbox")
}

model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  recipientId  String    @map("recipient_id") @db.Uuid
  invitationId String?   @unique @map("invitation_id") @db.Uuid
  settlementId String?   @map("settlement_id") @db.Uuid
  expenseRevisionId String? @map("expense_revision_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)

  recipient  User            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  invitation GroupInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  expenseRevision ExpenseRevision? @relation(fields: [expenseRevisionId], references: [id], onDelete: Cascade)

  @@unique([settlementId, recipientId])
  @@unique([expenseRevisionId, recipientId])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  requestId  String?  @map("request_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([groupId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_events")
}
