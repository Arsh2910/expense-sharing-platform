DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Expense App <noreply@example.com>
APP_BASE_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
# Shared outbox encryption key for the API and worker. Required in production.
# Generate with: openssl rand -hex 32
PASSWORD_RESET_OUTBOX_KEY=
# Optional comma-separated additional frontend origins. Use HTTPS origins in production.
CORS_ALLOWED_ORIGINS=
# Comma-separated reverse proxy IPs or CIDRs. Leave empty for direct connections.
TRUSTED_PROXY_IPS=
# Optional OAuth sign-in. Set the public API origin and one or both credential pairs.
# Local API origin example: http://localhost:5000
OAUTH_API_ORIGIN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
